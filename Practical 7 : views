USE FYStudentsDB;
SELECT * FROM Students;
-- 1. Columnar View (specific columns)
CREATE VIEW Contact_Details AS
SELECT 
StudentID,
concat(firstName," ",Lastname) as 'Name',
phone,email,AdmissionDate
FROM Students;
select * from Contact_details;

UPDATE Students SET LastName = 'Mehta' WHERE StudentID = 1;

-- 2. Row-wise View (filter rows)
CREATE VIEW science_students AS
SELECT * FROM Students WHERE Stream='Science';

Select * from Science_students;

-- 3. Subset View Display's Some rows and columns.
Create View Mumbai_Students_Data AS
SELECT 
StudentID,
concat(firstName," ",Lastname) as 'Name',
phone,email,AdmissionDate
FROM Students where city = 'Mumbai';

Select * from Mumbai_Students_Data;
-- 4. Query views and droping view.
SELECT * FROM Contact_Details;
SELECT * FROM science_students;
